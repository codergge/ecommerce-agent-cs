# ===== 大模型提供商 =====
# 可选: ollama / openai / dashscope / deepseek
LLM_PROVIDER=ollama

# ===== Ollama 本地部署 =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
# Qwen3 默认输出思考过程，设 false 关闭（省 token，前端也不会出现思考块）
OLLAMA_THINK=false

# ===== OpenAI / 兼容接口（切换为 openai 时填写） =====
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== 业务模拟数据库（订单/物流/库存） =====
# 默认读取 data/ecommerce.db，一般不需要改
# BUSINESS_DB_PATH=data/ecommerce.db

# ===== 其他 =====
TEMPERATURE=0.3
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MEMORY_WINDOW=10
